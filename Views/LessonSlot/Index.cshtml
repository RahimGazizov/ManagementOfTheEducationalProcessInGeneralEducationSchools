@model LessonSlotViewModal
<h3>Время уроков</h3>
<div class="conteiner">
    <div class="action">
        <button id="openModalBtn" class="btn btn_add">Добавить время урока</button>
        <a href="@Url.Action("Index", "AdminPersonalAccount")" class="btn_back">Вернуться</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>Номер урока</th>
                <th>Время начало урока</th>
                <th>Время конца урока</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.LessonSlots)
            {
                <tr>
                    <td>@l.LessonNumber</td>
                    <td>@l.StartTime.ToString(@"hh\:mm")</td>
                    <td>@l.EndTime.ToString(@"hh\:mm")</td>
                    <td>
                        <div class="action">
                            <form method="post" asp-action="Delete" asp-route-id="@l.Id"
                                  onsubmit="return confirm('Вы уверены что хотите удалить?')">
                                <button type="submit" class="btn_del">Удалить</button>
                            </form>
                            <button type="button"
                                    data-id="@l.Id"
                                    data-name="@l.LessonNumber"
                                    data-start="@l.StartTime.ToString(@"hh\:mm")"
                                    data-end="@l.EndTime.ToString(@"hh\:mm")"
                                    class="btn_edit editBtn">
                                Редактировать
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal @(Model.IsOpenModalAdd ? "show" : "")" id="modalAdd">
    <div class="modal-content">
        @if (TempData["Error"] != null)
        {
            <div>@TempData["Error"]</div>
        }
        <form method="post" asp-action="AddLessonSlot">
            <input type="number" asp-for="Form.LessonNumber" placeholder="Номер урока" required />
            <input type="time" asp-for="Form.StartTime" placeholder="Время начало урока" required />
            <input type="time" asp-for="Form.EndTime" placeholder="Время конца урока" required />
            <button type="submit" class="btn btn_add">Создать</button>
            <a href="@Url.Action("Index")" class="btn btn_back">Выйти</a>

        </form>
    </div>
</div>
<div class="modal @(Model.IsOpenModalEdit ? "show" : "")" id="modalEdit">
    <div class="modal-content">
        @if (TempData["Error"] != null)
        {
            <div>@TempData["Error"]</div>
        }
        <form method="post" asp-action="EditLessonSlot">
            <input type="hidden" asp-for="Form.Id" id="editId" required />
            <input type="number" asp-for="Form.LessonNumber" id="editLessonNum" required />
            <input type="time" asp-for="Form.StartTime" id="editStart" required />
            <input type="time" asp-for="Form.EndTime" id="editEnd" required />
            <button type="submit" class="btn btn_add">Сохранить</button>
            <a href="@Url.Action("Index")" class="btn btn_back">Выйти</a>

        </form>
    </div>
</div>

<style>
    body {
        padding: 0;
        margin: 0;
        font-family: 'Times New Roman', Times, serif;
    }

    .conteiner {
        width: 800px;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        margin: 15px auto;
        background: #fff;
    }

    h3 {
        text-align: center;
        margin-top: 40px;
        color: dimgray;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px auto;
    }

        table th {
            background-color: #007bff;
            color: white;
            padding: 12px;
            text-align: left;
        }

        table td {
            padding: 10px;
            /*     border-bottom: 1px solid #ddd; */
            text-align: left;
        }

    tbody tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    tbody tr:hover {
        background-color: #e0f7fa;
    }

    .action {
        display: flex;
        justify-content: left;
        gap: 10px;
    }

    .btn_del {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: red;
        color: white;
        transition: background-color 0.2s;
    }

        .btn_del:hover {
            background-color: darkred;
        }

    .btn_edit {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: green;
        color: white;
        transition: background-color 0.2s;
    }

        .btn_edit:hover {
            background-color: forestgreen;
        }

    .btn_add {
        display: inline-block;
        padding: 8px 12px;
        color: white;
        border: none;
        background-color: blue;
        text-decoration: none;
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

        .btn_add:hover {
            transform: scale(1.1);
        }

    .btn_back {
        display: inline-block;
        padding: 8px 12px;
        color: white;
        text-decoration: none;
        background-color: blue;
        text-decoration: none;
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

        .btn_add:hover {
            transform: scale(1.1);
            color: white;
        }

    .modal {
        display: none;
        width: 100%;
        background: rgba(0,0,0,0.5);
        justify-content: center;
        align-items: center;
        position: fixed;
    }

        .modal.show {
            display: flex;
            width: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            position: fixed;
        }

    .modal-content {
        width: 100%;
        max-width: 400px;
        background-color: #fff;
        border-radius: 12px;
        padding: 15px;
    }

    form {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        form input {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

    .btn {
        padding: 8px 12px;
        border-radius: 5px;
        color: white;
    }

        .btn.btn_add {
            background: #007bff;
            border: none;
        }

        .btn.btn_back {
            background: red;
            text-decoration: none;
        }
</style>
<script>
    const modalDiv = document.getElementById("modalAdd");
    const openBtn = document.getElementById("openModalBtn");
    const editModal = document.getElementById("modalEdit");
    const editButtons = document.querySelectorAll(".editBtn");
    openBtn.onclick = function(){
        modalDiv.style.display = "flex";
    }
    editButtons.forEach(btn => {
        btn.addEventListener("click", function(){
            document.getElementById("editId").value = this.dataset.id;
             document.getElementById("editLessonNum").value = this.dataset.name;
             document.getElementById("editStart").value = this.dataset.start;
             document.getElementById("editEnd").value = this.dataset.end;
             editModal.style.display = "flex";
        })
    })
    window.onclick = function(event){
        if(event.target == modalDiv){
            modalDiv.style.display = "none";
        }
        if(event.target == editModal){
            editModal.style.display = "none";
        }
    }
</script>