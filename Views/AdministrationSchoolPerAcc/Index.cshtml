@model AdministrationModelView
<h3>Добро пожаловать @Model.Administration.User.FullName!</h3>
<p>Это ваш личный кабинет</p>
<button type="button" id="btnAnaliticalReport" class="btn_view">Просмотр аналитического отчета</button>
<div id="modalAnaliticalReport" class="modal">
    <div class="modal-content">
        <h5>Данные для отчета</h5>
        <div id="errorMessage" style="color: red; font-size:18px;"></div>
        <label>Учебный год:</label>
        @if (Model.AcademicYears != null && Model.AcademicYears.Any())
        {
            <select class="academicListForAnalitical">
                @foreach (var academic in Model.AcademicYears)
                {
                    <option value="@academic.Value">@academic.Text</option>
                }
            </select>
        }
        else
        {
            <p style="width: 100%; padding: 8px 12px; border: 1px solid #ccc">Учебный год еще не добавлен</p>
        }
        <label>Четверть:</label>
        <select class="termListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Класс:</label>
        <select class="classListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Предмет:</label>
        <select class="subjectListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Студент:</label>
        <select class="studentsForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <button type="button" id="showReport">Открыть отчет</button>
    </div>
</div>
<style>
    select {
        padding: 8px 12px;
        border-radius: 5px;
        border: 1px solid #ccc;
        margin-bottom: 12px;
    }

    .modal {
        display: none;
        width: 100%;
        height: 100%;
        left: 0;
        top: 0;
        position: fixed;
        z-index: 1000;
        background: rgba(0,0,0,0.5);
        justify-content: center;
        align-items: center;
    }

    .show {
        display: flex;
    }

    .modal-content {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        width: 500px;
        max-height: 80vh;
        overflow-y: auto;
        animation: fadeIn 0.2s ease;
    }

    .btn_view {
        padding: 8px 12px;
        border: none;
        background-color: deepskyblue;
        color: white;
        border-radius: 5px;
    }

    #showReport {
        position: relative;
        padding: 12px 22px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
        overflow: hidden;
    }

        /* hover эффект */
        #showReport:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(79, 70, 229, 0.45);
        }

        /* нажатие */
        #showReport:active {
            transform: scale(0.96);
        }

        /* световой блик */
        #showReport::before {
            content: "";
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: rgba(255,255,255,0.25);
            transform: skewX(-25deg);
            transition: 0.5s;
        }

        #showReport:hover::before {
            left: 130%;
        }
</style>
<script src="~/js/ParentJSCode/openModal.js" asp-append-version="true"></script>
<script src="~/js/AdministrationJSCode/getDataByAcademinId.js" asp-append-version="true"></script>
<script src="/js/AdministrationJSCode/getAnaliticalReport.js" asp-append-version="true"></script>