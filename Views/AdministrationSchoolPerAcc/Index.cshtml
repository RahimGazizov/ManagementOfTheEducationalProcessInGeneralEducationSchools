@model AdministrationModelView
<div class="hero_panel">
    <div>
        <h1 class="page_title">Панель администрации школы</h1>
        <p class="page_subtitle">
            Аналитика успеваемости, отчеты и контроль учебного процесса
        </p>
    </div>

    <button type="button" id="btnAnaliticalReport" class="btn_view">
        Открыть аналитический отчет
    </button>
</div>
<div id="modalAnaliticalReport" class="modal">
    <div class="modal-content">
        <h5>Данные для отчета</h5>
        <div id="errorMessage" style="color: red; font-size:18px;"></div>
        <label>Учебный год:</label>
        @if (Model.AcademicYears != null && Model.AcademicYears.Any())
        {
            <select class="academicListForAnalitical">
                @foreach (var academic in Model.AcademicYears)
                {
                    <option value="@academic.Value">@academic.Text</option>
                }
            </select>
        }
        else
        {
            <p style="width: 100%; padding: 8px 12px; border: 1px solid #ccc">Учебный год еще не добавлен</p>
        }
        <label>Четверть:</label>
        <select class="termListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Класс:</label>
        <select class="classListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Предмет:</label>
        <select class="subjectListForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <label>Студент:</label>
        <select class="studentsForAnalitical">
            <option>Сначала выберите учебный год</option>
        </select>
        <button type="button" id="showReport">Открыть отчет</button>
    </div>
</div>
<style>
    body {
        margin: 0;
        padding: 25px;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #eef2ff, #f8fafc);
    }

    /* верхняя панель */
    .hero_panel {
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(12px);
        border-radius: 18px;
        padding: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }

    .page_title {
        margin: 0;
        font-size: 30px;
        color: #0f172a;
    }

    .page_subtitle {
        margin-top: 8px;
        color: #475569;
        font-size: 15px;
    }

    /* кнопка */
    .btn_view {
        border: none;
        padding: 14px 22px;
        border-radius: 14px;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.25s ease;
        box-shadow: 0 10px 25px rgba(79,70,229,0.25);
    }

        .btn_view:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(79,70,229,0.35);
        }

    /* modal */
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.55);
        z-index: 999;
        justify-content: center;
        align-items: center;
    }

    /* открытие */
    .show {
        display: flex;
    }

    /* окно */
    .modal-content {
        background: white;
        width: 540px;
        max-width: 95%;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 20px 45px rgba(0,0,0,0.2);
        animation: modalShow 0.25s ease;
    }

    /* анимация */
    @@keyframes modalShow {
        from {
            transform: translateY(15px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* заголовок модалки */
    .modal-content h5 {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 22px;
        color: #0f172a;
    }

    /* label */
    label {
        display: block;
        margin-bottom: 6px;
        margin-top: 14px;
        font-size: 14px;
        color: #334155;
        font-weight: 600;
    }

    /* select */
    select {
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        font-size: 14px;
        transition: 0.2s;
    }

        select:focus {
            border-color: #6366f1;
            outline: none;
            background: white;
        }

    /* ошибка */
    #errorMessage {
        margin-bottom: 10px;
        font-size: 15px;
    }

    /* кнопка отчета */
    #showReport {
        width: 100%;
        margin-top: 22px;
        padding: 14px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.25s ease;
    }

        #showReport:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(79,70,229,0.35);
        }
</style>
<script src="~/js/ParentJSCode/openModal.js" asp-append-version="true"></script>
<script src="~/js/AdministrationJSCode/getDataByAcademinId.js" asp-append-version="true"></script>
<script src="/js/AdministrationJSCode/getAnaliticalReport.js" asp-append-version="true"></script>