@model Students
@{
    ViewData["Title"] = "Расписание предметов";
}
<div class="conteiner">
    <h3>Расписание предметов</h3>
    <div class="btn_content">
        <button type="submit" id="moday" data-day="понедельник" class="btn">Понедельник</button>
        <button type="submit" id="moday" data-day="вторник" class="btn">Вторник</button>
        <button type="submit" id="moday" data-day="среда" class="btn">Среда</button>
        <button type="submit" id="moday" data-day="четверг" class="btn">Четверг</button>
        <button type="submit" id="moday" data-day="пятница" class="btn">Пятница</button>
        <button type="submit" id="moday" data-day="суббота" class="btn">Суббота</button>
        <input type="hidden" value="@Model.Id" id="studentIdForSchedule">
    </div>
    <div class="shedule_info" id="conteinerSchedule">
        Выберите день недели
    </div>
</div>

<style>
    .conteiner {
        width: 900px;
        margin: 15px auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 6px 8px rgba(0,0,0,0.1);
        padding: 20px;
    }

    .btn_content {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn {
        padding: 10px 16px;
        border: 1px solid #ccc;
        background: white;
        border-radius: 8px;
        cursor: pointer;
        margin: 4px;
    }

    .active-day {
        background-color: #0d6efd;
        color: white;
        border-color: #0d6efd;
        font-weight: 600;
    }

    h3 {
        text-align: center;
        font-size: 22px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table th,
        .table td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }

        .table th {
            background-color: #f5f5f5;
        }
</style>

<script src="~/js/scheduleStudents.js"></script>