    }

    .hello {
        font-size: 34px;
        font-weight: 700;
        color: #000;
        margin-bottom: 22px;
    }

    .parent-summary {
        margin-bottom: 18px;
    }

    .summary-pill {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 16px;
        border-radius: 18px;
