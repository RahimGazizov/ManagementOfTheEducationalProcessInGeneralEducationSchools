@model ModelViewForParents

@{
    var children = Model.Students?.ToList() ?? new List<StudentAvgScore>();
}

<div class="content parent-page">
    <div class="left-content">
        <a class="side-btn" id="btnOpenModalJournal" title="Посмотреть успеваемость">
            <i class="bi bi-journal-check"></i>
        </a>

        <a class="side-btn" id="btnOpenModalAvgScore" title="Посмотреть средний балл по предмету">
            <i class="bi bi-calculator"></i>
        </a>

        <a class="side-btn" id="btnOpenModalGraph" title="Просмотр графика по предмету">
            <i class="bi bi-bar-chart-line"></i>
        </a>

        <a class="side-btn" href="/ScheduleForStudent/Index" title="Расписание">
            <i class="bi bi-calendar3"></i>
        </a>

        <a class="side-btn" id="btnOpenModalRating" title="Рейтинг">
            <i class="bi bi-trophy"></i>
        </a>

        <a class="side-btn" asp-action="LogOut" title="Закрыть">
            <i class="bi bi-x-lg"></i>
        </a>
    </div>

    <div class="personalAcc parent-dashboard">
        <p class="hello">Привет, @Model.Parent.User.FullName.OnlyName()!</p>

        <div class="parent-summary">
            <div class="summary-pill">
                <span class="summary-label">Детей привязано</span>
                <span class="summary-value">@children.Count</span>
            </div>
        </div>

        <div class="parent-main-card">
            <div class="parent-card-header">
                <div>
                    <p class="parent-card-title">Мои дети</p>
                    <p class="parent-card-subtitle">Общая информация по ученикам</p>
                </div>
            </div>

            @if (children.Any())
            {
                <div class="children-list">
                    @foreach (var child in children)
                    {
                        <div class="child-card">
                            <div class="child-main-info">
                                <p class="child-name">@child.Student.User.FullName.ToShortName()</p>
                                <p class="child-class">
                                    @(child.Student.Class != null
                                                                ? $"{child.Student.Class.NumClass}\"{child.Student.Class.LetterClass}"
                                                                : "Класс не указан")
                        </p>
                    </div>

                            <div class="child-metric">
                                <p class="metric-label">Средний балл</p>
                                <p class="metric-value">@child.AvgScore</p>
                            </div>
                        </div>
                                }
                </div>
            }
            else
            {
                <div class="empty-children">
                    <p>У родителя пока нет привязанных детей</p>
                </div>
            }

            <div class="parent-footer-note">
                Здесь позже можно добавить рейтинг, уведомления или общую сводку по успеваемости.
            </div>
        </div>
    </div>
</div>

@*МОдальное окно просмотра журнала*@
<div class="modal" id="modelJournalView">
    <div class="modal-content">
        <h4>Просмотр журнала</h4>
        <label>Ученик:</label>
        @if (Model.Childrens != null && Model.Childrens.Any())
        {
            <select id="parentStudentId">
                <option>Выберите ребенка</option>
                @foreach (var child in Model.Childrens)
                {
                    <option value="@child.Value">@child.Text</option>
                }
            </select>
        }
        else
        {
            <input type="text" value="Вам пока неназначали ребенка" readonly />
        }
        <label>Предмет</label>
        <select id="parentStudentSubjectId" disabled>
            <option value="">Сначала выберите ученика</option>
        </select>
        <div id="journalListForParent" class="journalsList">
            Выберите предмет чтобы увидеть список журналов
        </div>
    </div>
</div>

@*Модальное окно просмотра среднего балла*@
<div class="modal" id="modelAvgGradeForParent">
    <div class="modal-content">
        <h5>Средний балл по предмету</h5>
        <label>Ученик:</label>
        @if (Model.Childrens != null && Model.Childrens.Any())
        {
            <select id="parentStudentIdForAvgScore">
                <option>Выберите ребенка</option>
                @foreach (var child in Model.Childrens)
                {
                    <option value="@child.Value">@child.Text</option>
                }
            </select>
        }
        else
        {
            <input type="text" value="Вам пока неназначали ребенка" readonly />
        }
        <label>Класс:</label>
        <select id="classIdForAvgScoreParent" disabled>
            <option>Сначала выберите ученика</option>
        </select>
        <label>Предмет:</label>
        <select id="parentStudentSubjectIdForAngScore" disabled>
            <option value="">Сначала выберите ученика</option>
        </select>
        <label>Учебный год</label>
        <input type="hidden" id="academicIdForAvgScoreParent">
        <input type="text" id="academicForAvgScoreParent" readonly>
        <label>Четверть</label>
        <select id="termIdForAvgScoreParent" disabled>
            <option>Выберите сначала ученика и предмет</option>
        </select>
        <button type="button" id="resultBtn" class="btn_result">Вывести результат</button>
        <div id="resultBlockForParent" class="result-card">
            <h6 class="result-title">Результат</h6>

            <div class="result-item">
                <span class="label">📘 Предмет:</span>
                <span id="resSubjectStudent" class="value"></span>
            </div>

            <div class="result-item">
                <span class="label">📊 Средний балл:</span>
                <span id="resAverageStudent" class="value highlight"></span>
            </div>

            <div class="result-item">
                <span class="label">📅 Посещаемость:</span>
                <span id="resAttendanceStudent" class="value"></span>
            </div>

            <div class="progress-bar">
                <div id="attendanceBarStudentForParent" class="progress-fill"></div>
            </div>
        </div>
    </div>
</div>

