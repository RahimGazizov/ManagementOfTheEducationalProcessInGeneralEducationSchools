<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .journalsList {
        padding: 10px;
        border-radius: 5px;
        max-height: 220px;
        border: 1px solid #e5e5e5;
        background-color: #fafafa;
        overflow-y: auto;
        font-size: 14px;
    }

    .journal_item {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-radius: 5px;
        padding: 8px;
        border: 1px solid #eee;
        background-color: #fff;
        align-items: center;
    }

    .journal_open {
        padding: 8px 12px;
        background-color: #007bff;
        border-radius: 5px;
        text-decoration: none;
        color: white;
    }

        .journal_open:hover {
            color: white;
            text-decoration: none;
        }

    .result-card {
        margin-top: 20px;
        box-shadow: 0 3px 5px rgba(0,0,0,0.1);
        padding: 20px;
        max-width: 400px;
        border-radius: 12px;
        font-family: Arial, sans-serif;
    }

    .result-title {
        text-align: center;
        color: slategray;
        font-weight: 600;
    }

    .result-item {
        display: flex;
        justify-content: space-between;
        font-size: 16px;
        margin-bottom: 10px;
    }

    .label {
        color: #666;
    }

    .value {
        font-weight: bold;
        color: #222;
    }

    .highlight {
        color: #2e86de;
        font-size: 18px;
    }

    .progress-bar {
        margin-top: 10px;
        height: 10px;
        border-radius: 10px;
        background-color: #eee;
        overflow: hidden;
    }

    .progress-fill {
        width: 0;
        height: 100%;
        background: linear-gradient(90deg, #4caf50, #2ecc71);
        transition: width 0.5s ease;
    }

    .btn_result {
        width: 100%;
        border: none;
        border-radius: 10px;
        background-color: greenyellow;
        color: white;
        margin-top: 10px;
        padding: 12px;
    }

    .showRating {
        width: 100%;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        border-radius: 12px;
        background-color: #fff;
        display: flex;
        flex-direction: column;
