        padding: 10px;
    }

    .rating-list {
        margin-top: 10px;
    }

    .rating-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

    .parent-page {
        display: flex;
        justify-content: space-between;
        padding: 0;
        margin: 0;
        gap: 24px;
    }

    .left-content {
        width: 72px;
        min-height: 470px;
        background: rgba(217, 217, 217, 1);
        border-radius: 36px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 18px 10px;
        gap: 16px;
    }

    .side-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(150, 150, 150, 1);
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        color: rgba(40, 40, 40, 1);
        cursor: pointer;
        transition: 0.2s ease;
        font-size: 18px;
    }

        .side-btn:hover {
            background: rgba(120, 120, 120, 1);
            color: white;
            transform: scale(1.05);
            text-decoration: none;
        }

        .side-btn i {
            font-size: 18px;
        }

    .personalAcc {
        width: 552px;
        min-height: 650px;
        border-radius: 41px;
        background-color: rgba(217, 217, 217, 1);
