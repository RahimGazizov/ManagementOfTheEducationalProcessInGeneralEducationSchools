@model List<Teachers>
<h3>Список учителей</h3>
<div class="conteiner">
    <div class="action">
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата рождения</th>
                <th>Логин</th>
                <th>Телефон</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0 && Model != null)
            {
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.User.FullName</td>
                        <td>@t.User.BirthDate.ToString("dd-MM-yyyy")</td>
                        <td>@t.User.UserName</td>
                        <td>@t.User.PhoneNumber</td>
                        <td>
                            <div class="action">
                                <form method="post" asp-controller="Users" asp-action="Delete"
                                      asp-route-id="@t.User.Id" asp-route-returnUrl="@Url.Action("Index","Teachers")" onsubmit="return confirm('Вы уверены что хотите удалить?')">
                                    <button type="submit" class="btn_del">Удалить</button>
                                </form>
                                <a asp-controller="Users" asp-action="EditUser" asp-route-id="@t.UserId"
                                   asp-route-returnUrl="@Url.Action("Index","Teachers")" class="btn_edit">Редоктировать</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" style="font-style:italic;text-align:center;">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>

<link rel="stylesheet" href="~/css/index.css" />