@model StudentDashboardViewModel
@if (TempData["Error"] != null)
{
    <div>@TempData["Error"]</div>
}
<div class="personalAcc">
    <p class="hello">Привет, @Model.Student.User.FullName.OnlyName()!</p>
    <div class="conteiner">
        <div class="schedule">
            <p style="font-weight: 500; font-size: 16px;">
                Твоё расписание<br>
                на сегодня
                @if (Model.Schedule != null && Model.Schedule.Any())
                {
                    @foreach (var sch in Model.Schedule)
                    {
                        <div class="schedule-content">
                            <div class="schedule-info">
                                <div class="div-time">
                                    <p class="time">@($"{sch.LessonSlot.StartTime.ToString(@"hh\:mm")}-{sch.LessonSlot.EndTime.ToString(@"hh\:mm")}")</p>
                                </div>
                                <p class="room">@($"каб.№{sch.Room}")</p>
                            </div>
                            <p class="sub-name">@sch.Assigment.Subject.Name</p>
                        </div>
                    }
                }
                else
                {
                <p>Расписание пока нет</p>
                }
            </p>
        </div>
        <div class="studentInfo">
            <p style="font-weight: 700;font-size:19px;color:rgba(255, 255, 255, 1);">@Model.Student.User.FullName.ToShortName()</p>
            <p style="font-weight: 700;font-size:19px;color:rgba(255, 255, 255, 0.8);">@Model.Student.Class.NumClass"@Model.Student.Class.LetterClass"</p>
            <p style="font-weight: 400; font-style: italic; font-size:10px; color:rgba(255, 255, 255, 0.8);">Средний балл</p>
            <p style="font-weight: 700; font-size:26px; color:rgba(255, 255, 255, 1);">@Model.AverageGrade</p>
            <a class="btnModalOpen" id="openModalBtn">Посмотреть успеваймость</a>
            <a class="btnModalOpen" id="openAveragePoints">Посмотреть средний балл по предмету</a> <br/>
            <a class="btnModalOpen" id="openGraph">Просмотр графика по предмету</a>
        </div>
    </div>
</div>
<div id="openModalForm" class="modal">
    <div class="modal-content">
        <form method="post" asp-action="JournalSet">
            <input type="hidden" name="studentId" id="studentID" value="@Model.Student.Id" />
            <label>Предмет</label>
            @if (Model.Subjects != null && Model.Subjects.Any())
            {
                <select id="subjectSelectHistory">
                    <option>Выберите предмет</option>
                    @foreach (var s in Model.Subjects)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            }
            else
            {
                <input value="Вам пока не назначены предметы" readonly />
            }
            <input type="hidden" name="classId" id="classID" value="@Model.Student.ClassId" />
            <label>Учебный год</label>
            @if (Model.AcademicYears != null && Model.AcademicYears.Any())
            {
                <select id="academicYearStudent">

                    @foreach (var a in Model.AcademicYears)
                    {
                        if (a.Value == Model.CurrentYear.Id)
                        {
                            <option value="@a.Value" selected>@a.Text</option>
                        }
                        else
                        {
                            <option value="@a.Value">@a.Text</option>
                        }
                    }

                </select>
            }
            else
            {
                <input type="text" value="Учебного года пока нет" readonly>
            }
            <label>Четверть</label>
            @if (Model.Terms != null && Model.Terms.Any())
            {
                <select id="termStudent">

                    @foreach (var a in Model.Terms)
                    {
                        if (a.Value == Model.CurrentTerm?.Id)
                        {
                            <option value="@a.Value" selected>@a.Text</option>
                        }
                        else
                        {
                            <option value="@a.Value">@a.Text</option>
                        }
                    }
                </select>
            }
            else
            {
                <input type="text" value="Четверти еще не добавлены" readonly>
            }
            <div id="journalsList" class="journalsList">
                Выберите предмет чтобы увидеть список журналов
            </div>
            <div style="display: flex; justify-content: center;gap: 10px">
                <a asp-action="Index" class="btn_back">Назад</a>
            </div>
        </form>
    </div>
</div>
<div class="modal" id="openAverageInfo">
    <div class="modal-content">
        <h3 style="text-align:center">Просмотр среднего балла</h3>
        <input type="hidden" value="@Model.Student.Id" id="studentId">
        <label>Класс</label>
        @if (Model.Classes != null && Model.Classes.Any())
        {
            <select id="classStudent" style="margin-bottom:15px;">
                <option>Выберите класс</option>
                @foreach (var c in Model.Classes)
                {
                    @*  if (c.Value == Model.CurrentClass.Id)
                    {
                        <option value="@c.Value" selected>@c.Text</option>
                    }
                    else
                    {
                        <option value="@c.Value">@c.Text</option>
                    } *@
                    <option value="@c.Value">@c.Text</option>
                }
            </select>
        }
        else
        {
            <p>Список классов пуст</p>
        }
        <label>Предмет</label>
        <select id="listSubject" style="margin-bottom:15px;" disabled>
            <option>Сначала выберите класс</option>
        </select>
        <label>Учебный год</label>
        <input type="hidden" id="academicYearId">
        <input type="text" id="academicYear" style="margin-bottom:15px;" readonly>
        <label>Четверть</label>
        <select id="listTerms" style="margin-bottom:15px;" disabled>
            <option>Выберите сначала класс</option>
        </select>
        <button type="button" id="btnResult" class="btn_result">Вывести результат</button>
        <div id="resultBlock" class="result-card">
            <h4 class="result-title">Результат</h4>

            <div class="result-item">
                <span class="label">📘 Предмет:</span>
                <span id="resSubject" class="value"></span>
            </div>

            <div class="result-item">
                <span class="label">📊 Средний балл:</span>
                <span id="resAverage" class="value highlight"></span>
            </div>

            <div class="result-item">
                <span class="label">📅 Посещаемость:</span>
                <span id="resAttendance" class="value"></span>
            </div>

            <div class="progress-bar">
                <div id="attendanceBar" class="progress-fill"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="graphModal">
    <div class="modal-content">
        <input type="hidden" value="@Model.Student.Id" id="studentID">
        <label>Класс</label>
        @if (Model.Classes != null && Model.Classes.Any())
        {
            <select id="studentClassId">
                <option>Выберите класс</option>
                @foreach (var cl in Model.Classes)
                {
                    <option value="@cl.Value">@cl.Text</option>
                }
            </select>
        }
        else
        {
            <input type="text" value="Вам не названили еще класс">
        }
        <label>Учебный год</label>
        <input id="academicValue" readonly>
        <input type="hidden" id="academicValueId">
        <label>Четверть</label>
        <select id="termList" disabled>
            <option>Сначала выберите класс</option>
        </select>
        <button type="button" id="showGraphBtn" class="btn_result" style="margin-top:15px;">Показать график</button>
    </div>
</div>
<script>
    const modal = document.getElementById("openModalForm");
    const btnOpen = document.getElementById("openModalBtn");
    const btnAverage = document.getElementById("openAveragePoints");
    const modalAverage = document.getElementById("openAverageInfo");
    const graphModal = document.getElementById("graphModal")
    const graphBtn = document.getElementById("openGraph");
    btnOpen.onclick = ()=>{
        modal.style.display = "flex";
    }

    btnAverage.onclick = ()=>{
        modalAverage.style.display = "flex";
    }

    graphBtn.onclick = ()=>{
        graphModal.style.display = "flex";
    }
    window.onclick = function(event){
        if(event.target === modal){
            modal.style.display = "none";
        }
        if(event.target === modalAverage){
            modalAverage.style.display = "none";
        }
        if(event.target === graphModal){
            graphModal.style.display = "none";
        }
    }
</script>
<link rel="stylesheet" href="/css/studentPerAcc.css" />
<script src="/js/journalsForStudent.js"></script>
<script src="/js/getInfoAboutClass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/dataForGraph.js"></script>