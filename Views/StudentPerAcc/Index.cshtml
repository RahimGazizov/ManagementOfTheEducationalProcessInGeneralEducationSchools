@model Students
@{
    var subjectList = ViewBag.ListSubject as List<Subjects>;
}
@if (TempData["Error"] != null)
{
    <div>@TempData["Error"]</div>
}
<div class="personalAcc">
    <p class="hello">Привет, @Model.User.FullName.OnlyName()!</p>
    <div class="conteiner">
        <div class="schedule">
            <p style="font-weight: 500; font-size: 16px;">
                Твоё расписание<br>
                на сегодня
            </p>
        </div>
        <div class="studentInfo">
            <p style="font-weight: 700;font-size:19px;color:rgba(255, 255, 255, 1);">@Model.User.FullName.ToShortName()</p>
            <p style="font-weight: 700;font-size:19px;color:rgba(255, 255, 255, 0.8);">@Model.Class.NumClass"@Model.Class.LetterClass"</p>
            <p style="font-weight: 400; font-style: italic; font-size:8px; color:rgba(255, 255, 255, 0.8);">Средний балл</p>
            <p style="font-weight: 700; font-size:26px; color:rgba(255, 255, 255, 1);">@ViewBag.AverageGrade</p>
            <button type="button" class="form" id="openModalBtn">Посмотреть успеваймость</button>
        </div>
    </div>
</div>
<div id="openModalForm" class="modal">
    <div class="modal-content">
        <form method="post" asp-action="JournalSet">
            <input type="hidden" name="studentId" id="studentID" value="@Model.Id" />
            <label>Предмет</label>
            <select name="subjectId" id="subjectSelectHistory">
                <option>Выберите предмет</option>
                @foreach (var s in subjectList)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <input type="hidden" name="classId" id="classID" value="@Model.ClassId" />
            <label>Дата начало:</label>
            <input type="date" id="dateFrom" />
            <label>Дата конца:</label>
            <input type="date" id="dateTo" />
            <div id="journalsList" class="journalsList">
                Выберите предмет чтобы увидеть список журналов
            </div>
            <div style="display: flex; justify-content: center;gap: 10px">
                <a asp-action="Index" class="btn_back">Назад</a>
            </div>
        </form>
    </div>
</div>
<style>
    body {
        padding: 0;
        margin: 0;
        font-family: Inter;
    }

    .personalAcc {
        width: 552px;
        height: 987px;
        top: 46px;
        left: 680px;
        opacity: 1;
        border-radius: 41px;
        background-color: rgba(217, 217, 217, 1);
        padding: 20px;
    }

    .hello {
        font-weight: 700;
        font-size: 30px;
        color: rgba(0, 0, 0, 1);
    }

    .conteiner {
        display: flex;
        justify-content: space-between;
    }

    .schedule {
        width: 249px;
        height: 306px;
        top: 137px;
        left: 706px;
        padding: 16px;
        background-color: rgba(173, 173, 173, 1);
        border-radius: 15px;
    }

    .studentInfo {
        width: 249px;
        height: 306px;
        top: 137px;
        left: 706px;
        padding: 16px;
        background-color: rgba(103, 103, 103, 1);
        border-radius: 15px;
    }

        .studentInfo p {
            margin: 0;
        }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        background-color: rgba(0,0,0,0.5);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        width: 400px;
        padding: 20px;
        background-color: #fff;
        border-radius: 8px;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        form select, input {
            width: 100%;
            border: 1px solid #ccc;
            padding: 8px 12px;
            border-radius: 5px;
        }


    .btn_back {
        padding: 8px 12px;
        background-color: #dc3545;
        border-radius: 5px;
        text-decoration: none;
        color: white;
    }

    .journalsList {
        padding: 10px;
        border-radius: 5px;
        max-height: 220px;
        border: 1px solid #e5e5e5;
        background-color: #fafafa;
        overflow-y: auto;
        font-size: 14px;
    }

    .journal_item {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-radius: 5px;
        padding: 8px;
        border: 1px solid #eee;
        background-color: #fff;
        align-items: center;
    }

    .journal_open {
        padding: 8px 12px;
        background-color: #007bff;
        border-radius: 5px;
        text-decoration: none;
        color: white;
    }

        .journal_open:hover {
            color: white;
            text-decoration: none;
        }
</style>

<script>
    const modal = document.getElementById("openModalForm");
    const btnOpen = document.getElementById("openModalBtn");

    btnOpen.onclick = ()=>{
        modal.style.display = "flex";
    }
    window.onclick = function(event){
        if(event.target === modal){
            modal.style.display = "none";
        }
    }
</script>
<script src="/js/getJournalsForStudent.js"></script>