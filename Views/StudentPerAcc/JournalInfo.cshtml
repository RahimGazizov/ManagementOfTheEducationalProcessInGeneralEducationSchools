@model Journal
@if (Model == null)
{
    <div>Данных пока нет</div>
}
else
{
    <div class="conteiner">
        <h3>Предмет: @Model.Subject.Name</h3>
        <p>Учитель: @Model.Teacher.User.FullName</p>
        <p>Дата: @Model.Entries.Select(d => d.Date.ToString("dd-MM-yyyy")).FirstOrDefault()</p>
        <p>Домашнее задание: @Model.HomeWork</p>
        <p>Тема урока: @Model.LessonTopic</p>
        <div class="action">
            <a asp-action="Index" class="btn_back">Вернуться</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>ФИО ученика</th>
                    <th>Оценка</th>
                    <th>Присутствие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model.Entries)
                {
                    <tr>
                        <td>@j.Student.User.FullName</td>
                        <td>@(j.Grade != null ? j.Grade : "-")</td>
                        <td>@(j.IsPresent ? "Присутствовал" : "Отсутствовал")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f6f8;
        margin: 0;
        padding: 0;
    }

    h3 {
        color: #2c3e50;
        margin-bottom: 5px;
        font-size: 22px;
    }

    p {
        color: #34495e;
        margin: 2px 0 10px 0;
    }

    .conteiner {
        background-color: #fff;
        padding: 20px;
        margin: 20px auto;
        border-radius: 12px;
        max-width: 900px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .action {
        display: flex;
        justify-content: left;
        gap: 10px;
        align-items: center;
    }

        .action a {
            border-radius: 5px;
            text-decoration: none;
            color: white;
            padding: 8px 20px;
        }

    .btn_back {
        background-color: #007bff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        table th, table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        table th {
            background-color: #3498db;
            color: white;
            font-weight: 600;
        }

        table tr:hover {
            background-color: #f1f7fb;
        }
</style>
