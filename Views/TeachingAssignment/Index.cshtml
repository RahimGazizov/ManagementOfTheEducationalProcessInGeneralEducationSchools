@model List<TeacherAssigment>
<h1>Список учителей, ведущих предметы для каждого класса</h1>
<div class="conteiner">
    @if (TempData["Error"] != null)
    {
        <p style="color:red;font-size:19px;">@TempData["Error"]</p>
    }
    <div class="action">
        <a href="/TeachingAssignment/Add" class="btn_add">Добавить запись</a>
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>ФИО учителя</th>
                <th>Класс</th>
                <th>Предмет</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any() && Model != null)
            {
                @foreach (var assigment in Model)
                {
                    <tr>
                        <td>@assigment.Teacher.User.FullName</td>
                        <td>@assigment.Class.NumClass@assigment.Class.LetterClass</td>
                        <td>@assigment.Subject.Name</td>
                        <td>
                            <div class="action">
                                <form method="post" asp-action="Delete" asp-route-id="@assigment.Id">
                                    <button type="submit" class="btn_del">Удалить</button>
                                </form>
                                <form method="get" asp-action="Edit" asp-route-id="@assigment.Id">
                                    <button type="submit" class="btn_edit">Редоктировать</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" style="font-style:italic;text-align:center;">Список пуст</td></tr>
            }
        </tbody>
    </table>
</div>
<style>
    body {
        font-family: 'Times New Roman', Times, serif;
        margin: 0;
        padding: 0;
        background-color: #f8f9fa;
    }

    h1 {
        font-size: 28px;
        font-weight: bold;
        margin-top: 20px;
        text-align: center;
        color: #333;
    }

    .conteiner {
        width: 1000px;
        margin: 20px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        table th {
            background-color: #007bff;
            color: white;
            padding: 12px;
            text-align: left;
        }

        table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

    tbody tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    tbody tr:hover {
        background-color: #e0f7fa;
    }

    .action {
        display: flex;
        justify-content: left;
        gap: 10px;
    }

    .btn_del {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: red;
        color: white;
        transition: background-color 0.2s;
    }

        .btn_del:hover {
            color: white;
            background-color: darkred;
        }

    .btn_edit {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: green;
        color: white;
        transition: background-color 0.2s;
        text-decoration: none;
    }

        .btn_edit:hover {
            color: white;
            background-color: forestgreen;
        }

    .btn_add {
        display: inline-block;
        padding: 8px 12px;
        color: white;
        background-color: blue;
        text-decoration: none;
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

        .btn_add:hover {
            color: white;
            background-color: #007bff;
            transform: scale(1.1);
        }

    .btn_add {
        display: inline-block;
        padding: 8px 12px;
        color: white;
        border: none;
        background-color: blue;
        text-decoration: none;
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

        .btn_add:hover {
            color: white;
            background-color: #007bff;
            transform: scale(1.1);
        }

    .btn_back {
        padding: 8px 12px;
        text-decoration: none;
        border-radius: 5px;
        background-color: #007bff;
        color: white;
    }
</style>