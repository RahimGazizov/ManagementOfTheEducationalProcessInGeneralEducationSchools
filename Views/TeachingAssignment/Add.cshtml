@model TeacherAssigment
@{
    var listT = ViewBag.ListTeachers as List<SelectListItem>;
    var listS = ViewBag.ListSubjects as List<SelectListItem>;
}
<h3>Добавление новой записи</h3>
<div class="page-header">
    <div style="display: flex; justify-content: left">
        <a asp-action="Index" class="back-link">← Назад</a>
    </div>
</div>
<div class="conteiner">
    @if(TempData["Error"] != null){
        <div class="text-danger">@TempData["Error"]</div>
    }
    <form method="post" asp-action="Add">
        <label>Учитель</label>
        <select asp-for="TeacherId">
            <option>Выберите учителя</option>
            @foreach (var t in listT)
            {
                <option value="@t.Value">@t.Text</option>
            }
        </select>
        <label>Предмет</label>
        <select asp-for="SubjectId">
            <option>Выберите Предмет</option>
            @foreach (var s in listS)
            {
                <option value="@s.Value">@s.Text</option>
            }
        </select>
            <label>Выберите номер класса</label>
            <select id="numClassSelect">
                <option value="">Выберите номер</option>
                @for (int i = 1; i < 12; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
            <label>Выберите букву класса</label>
            <select id="letterClassSelect" asp-for="ClassId">
                <option value="">Сначала выберите номер</option>
            </select>
            <button type="submit" class="btn_add">Добавить</button>
    </form>
</div>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f7fb;
    }

    h3 {
        text-align: center;
        font-size: 26px;
        margin-top: 60px;
        color: #1f2937;
    }

    .conteiner {
        width: 500px;
        padding: 25px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin: 20px auto;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        color: #374151;
        font-weight: 500;
    }

    input, select {
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        transition: 0.2s;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn_add {
        margin-top: 10px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn_add:hover {
            background: #2563eb;
        }

    .text-danger {
        color: #dc2626;
        font-size: 18px;
    }

    .page-header {
        width: 500px;
        margin: 0 auto;
    }

    .back-link {
        text-decoration: none;
        color: #2a5298;
        font-weight: 500;
        text-align: left;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>
<script src="~/js/classLetter.js"></script>