@model TeacherAssigment
@{
    var listT = ViewBag.ListTeachers as List<SelectListItem>;
    var listS = ViewBag.ListSubjects as List<SelectListItem>;
}
<h3>Редоктирование</h3>
<div class="conteiner">
    @if (TempData["Error"] != null)
    {
        <div class="text-danger">@TempData["Error"]</div>
    }
    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="Id" value="@Model.Id" />
        <label>Учитель</label>
        <select asp-for="TeacherId">
            <option>Выберите учителя</option>
            @foreach (var t in listT)
            {
                if (Model.Teacher.User.FullName == t.Text)
                {
                    <option value="@t.Value" selected>@t.Text</option>
                }
                else
                {
                    <option value="@t.Value">@t.Text</option>

                }
            }
        </select>
        <label>Предмет</label>
        <select asp-for="SubjectId">
            <option>Выберите Предмет</option>
            @foreach (var s in listS)
            {
                if (Model.Subject.Name == s.Text)
                {
                    <option value="@s.Value" selected>@s.Text</option>
                }
                else
                {
                    <option value="@s.Value">@s.Text</option>
                }
            }
        </select>
        <label>Выберите номер класса</label>
        <select id="numClassSelect">
            <option value="">Выберите номер</option>
            @for (int i = 1; i < 12; i++)
            {
                if (Model.Class.NumClass == i)
                {
                    <option value="@i" selected>@i</option>
                }
                else
                {
                    <option value="@i">@i</option>
                }
            }
        </select>
        <label>Выберите букву класса</label>
        <select id="letterClassSelect" asp-for="ClassId">
            @if (Model.Class.LetterClass != null)
            {
                <option value="@Model.ClassId" selected>@Model.Class.LetterClass</option>
            }
            else
            {
                <option value="">Сначала выберите номер</option>
            }
        </select>
        <button type="submit" class="btn_add">Обновить</button>
    </form>
</div>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f7fb;
    }

    h3 {
        text-align: center;
        font-size: 26px;
        margin-top: 60px;
        color: #1f2937;
    }

    .conteiner {
        width: 500px;
        padding: 25px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin: 20px auto;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        color: #374151;
        font-weight: 500;
    }

    input, select {
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        transition: 0.2s;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn_add {
        margin-top: 10px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn_add:hover {
            background: #2563eb;
        }

    .text-danger {
        color: #dc2626;
        font-size: 18px;
    }
</style>
<script src="~/js/classLetter.js"></script>