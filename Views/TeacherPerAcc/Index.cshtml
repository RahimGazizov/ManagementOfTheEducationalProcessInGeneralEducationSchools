@model Teachers
@{
    var listS = ViewBag.ListSubjects as List<Subjects>;
    var academicList = ViewBag.ListAcademicYear as List<SelectListItem>;
    var termList = ViewBag.ListTerms as List<SelectListItem>;
}
<h1 class="page_title">Личный кабинет учителя</h1>
@if (TempData["Error"] != null)
{
    <p style="color:red;font-size: 19px;">@TempData["Error"]</p>
}
<button type="button" id="openForm" class="btn_open">Создать электронный журнал</button>
<button type="button" id="openFormJournal" class="btn_open">История журналов</button>
@* <a href="/TeacherPerAcc/ListJournal">журналы</a> *@
<div id="modal" class="modal_window">
    <div class="modal_content">
        <span id="closeModal" class="close">&times;</span>
        <form method="post" asp-controller="Journal" asp-action="Create">
            <input type="hidden" name="teacherId" value="@Model.Id" />
            <div class="form_row">
                <label>Предмет:</label>
                @if (listS != null && listS.Any())
                {
                    <select id="subjectSelectCreate" name="subjectId">
                        <option value="">Выберите предмет</option>
                        @foreach (var s in listS)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                }
                else
                {
                    <input value="Вам пока не назначены предметы" readonly />
                }
            </div>
            <div class="form_row">
                <label>Класс:</label>
                <select id="classSelectCreate" name="classId" disabled>
                    <option>Сначала выберите предмет</option>
                </select>
            </div>
            <div class="form_row buttons">
                <button type="submit" class="btn_create">Создать</button>
                <a href="/TeacherPerAcc/Index" class="btn_exit">Выйти</a>
            </div>
        </form>
    </div>
</div>
<div id="modelForm" class="modal_window">
    <div class="modal_content">
        <form asp-action="JournalHistory" method="post">
            <div class="form_row">
                <label>Предмет:</label>
                <select id="subjectSelectHistory">
                    <option>Выберите предмет</option>
                    @foreach (var s in listS)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="form_row">
                <label>Класс:</label>
                <select id="classSelectHistory" disabled>
                    <option>Сначала выберите предмет</option>
                </select>
            </div>
            <div class="form_row">
                <div id="journalsList" class="journals_list">
                    Выберите предмет и класс, чтобы увидеть журналы
                </div>
            </div>
            <div class="form_row buttons">
                <a href="/TeacherPerAcc/Index" class="btn_exit">Выйти</a>
            </div>
        </form>
    </div>
</div>
<a asp-action="LogOut" class="btn_exit">Выйти</a>
<style>

    body {
        background: #eef2f7;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
    }

    /* заголовок */
    .page_title {
        font-size: 24px;
        font-weight: 600;
        color: #1f2d3d;
        margin-bottom: 20px;
    }

    /* кнопки сверху */
    .btn_open {
        padding: 10px 16px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        margin-right: 10px;
        transition: 0.2s;
        font-size: 14px;
    }

        .btn_open:hover {
            background: #1e4fd6;
        }

    /* затемнение экрана */
    .modal_window {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        z-index: 999;
        justify-content: center;
        align-items: center;
    }

    /* само окно */
    .modal_content {
        background: #fff;
        padding: 20px;
        border-radius: 14px;
        width: 420px;
        max-width: 92%;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        position: relative;
    }

    /* крестик */
    .close {
        position: absolute;
        top: 10px;
        right: 12px;
        font-size: 22px;
        cursor: pointer;
        color: #555;
    }

        .close:hover {
            color: #000;
        }

    /* форма */
    .form_row {
        display: flex;
        flex-direction: column;
        margin-bottom: 12px;
    }

        .form_row label {
            font-size: 13px;
            color: #334155;
            margin-bottom: 4px;
        }

    select, input {
        padding: 8px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        outline: none;
    }

    /* кнопки внутри формы */
    .form_row.buttons {
        display: flex;
        justify-content: space-between;
        flex-direction: row;
        margin-top: 10px;
    }

    .btn_create {
        background: #22c55e;
        color: #fff;
        padding: 8px 14px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn_create:hover {
            background: #16a34a;
        }

    .btn_exit {
        background: #ef4444;
        color: #fff;
        padding: 8px 14px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }

        .btn_exit:hover {
            background: #dc2626;
        }

    /* список журналов */
    .journals_list {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 12px;
        max-height: 240px;
        overflow-y: auto;
    }

    /* если есть элементы журнала */
    .journal_item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        margin-bottom: 8px;
    }

        .journal_item:last-child {
            margin-bottom: 0;
        }

        /* текст внутри */
        .journal_item span {
            font-size: 14px;
            color: #1f2937;
        }

    /* кнопка открыть/редактировать */
    .journal_open {
        padding: 6px 10px;
        background: #2563eb;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        font-size: 13px;
    }

        .journal_open:hover {
            background: #1d4ed8;
        }
</style>
<script>
    var openModal = document.getElementById("openForm");
    var model = document.getElementById("modal");
    var close = document.getElementById("closeModal");
    openModal.onclick = ()=> {
        model.style.display = "flex";
    }
    close.onclick = ()=> {
        model.style.display = "none";
    }

    const openModalForJournal = document.getElementById("openFormJournal");
    const modelJournal = document.getElementById("modelForm");
    openModalForJournal.onclick = ()=>{
        modelJournal.style.display = "flex";
    }

       window.onclick = function(event){
        if(event.target == model){
            model.style.display = "none";
        }

        if(event.target == modelJournal){
            modelJournal.style.display = "none";
        }
    }
</script>
<script src="/js/classesForTeacherGet.js"></script>
<script src="/js/journalsForTeachers.js"></script>