@model ModelViewAdmin

<style>
    .admin-container {
        max-width: 900px;
        margin: 40px auto;
        font-family: Arial;
        text-align: center;
    }

    .admin-title {
        margin-bottom: 30px;
    }

    .menu {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 15px;
        margin-top: 30px;
    }

        .menu a {
            display: block;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
            text-decoration: none;
            color: #333;
            font-weight: 600;
            transition: 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

            .menu a:hover {
                background: #e0f7fa;
                transform: translateY(-2px);
            }

        .menu button {
            display: block;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
            border: none;
            color: #333;
            font-weight: 600;
            transition: 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

            .menu button:hover {
                background: #e0f7fa;
                transform: translateY(-2px);
            }

    .logout {
        margin-top: 40px;
    }

        .logout a {
            padding: 10px 20px;
            background: #e53935;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

            .logout a:hover {
                background: #c62828;
            }

    /* фон */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

        /* показать */
        .modal.show {
            display: flex;
        }

    /* окно */
    .modal-content {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        width: 500px;
        max-height: 80vh;
        overflow-y: auto;
        animation: fadeIn 0.2s ease;
    }

    /* header */
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    /* крестик */
    .close-modal {
        font-size: 22px;
        cursor: pointer;
    }

    /* список */
    .backup-list {
        list-style: none;
        padding: 0;
    }

    /* элемент */
    .backup-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8f9fa;
        padding: 10px 14px;
        margin-bottom: 8px;
        border-radius: 8px;
    }

    /* имя */
    .backup-name {
        font-size: 14px;
        color: #333;
    }

    /* кнопка */
    .btn-restore {
        background: #4CAF50;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-restore:hover {
            background: #43a047;
        }

</style>

<div class="admin-container">

    <h3 class="admin-title">
        Панель администратора
    </h3>
    @if (TempData["Error"] != null)
    {
        <div class="message" style="color:red; font-size: 18px;">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="message" style="color:lightgreen; font-size: 18px;">@TempData["Success"]</div>
    }
    <div class="menu">
        @* <button id="on">Включить maintenance</button>
        <button id="off">Выключить maintenance</button> *@

        <a href="/Users/Index">Пользователи</a>

        <a href="/Class/Index">Классы</a>

        <a href="/Students/Index">Ученики</a>

        <a href="/Subjects/Index">Предметы</a>

        <a href="/Teachers/Index">Учителя</a>

        <a href="/LessonSlot/Index">Время уроков</a>

        <a href="/ScheduleLesson/Index">Расписание</a>

        <a href="/TeachingAssignment/Index">Назначения учителей</a>

        <a href="/AcademicYear/Index">Учебный год</a>

        <a href="/Term/Index">Четверть</a>

        <a href="/Parents/Index">Родители</a>

        <a href="/ActionLogs/Index">Логи действий</a>

        <a href="/SchoolAdministrations/Index">Администрация школы</a>

        <form asp-controller="AdminPersonalAccount" asp-action="CreateBackup" method="post">
            <button type="submit">
                Создать резервную копию
            </button>
        </form>

        <a id="btnForRestoreBackup">Восстонавить базу данных</a>
    </div>

    <div class="logout">
        <a asp-action="LogOut">Выйти</a>
    </div>

</div>
<div id="modalForRestoreBackup" class="modal">
    <div class="modal-content">

        <div class="modal-header">
            <h5>Резервные копии</h5>
            <span class="close-modal" id="closeModal">&times;</span>
        </div>

        @if (Model.ListBackups != null && Model.ListBackups.Any())
        {
            <ul class="backup-list">
                @foreach (var file in Model.ListBackups)
                {
                    <li class="backup-item">
                        <span class="backup-name">@file</span>

                        <form asp-action="RestoreBackup" method="post" onsubmit="return confirm('Восстановить эту копию? Все текущие данные будут потеряны!');">
                            <input type="hidden" name="fileName" value="@file" />
                            <button type="submit" class="btn-restore">Восстановить</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="none_data">Резервных копий нет</p>
        }

    </div>
</div>
<script>
    setTimeout(function(){
        const messages = document.querySelectorAll(".message");
       messages.forEach(function(msg){
            msg.style.display = "none";
       })
    }, 5000);
    const close = document.getElementById("closeModal");

    close.addEventListener("click", () => {
        document.getElementById("modalForRestoreBackup").classList.remove("show");
    });
</script>
<script src="~/js/ParentJSCode/openModal.js"></script>
<script src="~/js/MaintenanceTest.js"></script>