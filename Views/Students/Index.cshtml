@model List<Students>
<h3>Ученики школы</h3>
<div class="conteiner">
    <div class="action">
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата рождения</th>
                <th>Класс</th>
                <th>Логин</th>
                <th>Телефон</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0 && Model != null)
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.User.FullName</td>
                        <td>@student.User.BirthDate.ToString("dd-MM-yyy")</td>
                        <td>
                            @(student.Class != null ? $"{student.Class.NumClass}{student.Class.LetterClass}" : "Нет класса")
                        </td>
                        <td>@student.User.UserName</td>
                        <td>@student.User.PhoneNumber</td>
                        <td>
                            <div class="action">
                                <form method="post" asp-controller="Users" asp-action="Delete" asp-route-id="@student.UserId"
                                      onsubmit="return confirm('Вы уверены что хотите удалить?')" asp-route-returnUrl="@Url.Action("Index","Students")">
                                    <button type="submit" class="btn_del">Удалить</button>
                                </form>
                                <a asp-controller="Users" asp-action="EditUser" asp-route-id="@student.UserId"
                                   asp-route-returnUrl="@Url.Action("Index","Students")" class="btn_edit">Редоктировать</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" style="font-style:italic;text-align:center;">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>
<link rel="stylesheet" href="/css/index.css">