@model List<Students>
<h1>Ученики школы</h1>
<div class="conteiner">
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата рождения</th>
                <th>Класс</th>
                <th>Логин</th>
                <th>Телефон</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0 && Model != null)
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.User.FullName</td>
                        <td>@student.User.BirthDate</td>
                        <td>@student.Class.NumClass@student.Class.LetterClass</td>
                        <td>@student.User.FullName</td>
                        <td>@student.User.PhoneNumber</td>
                        <td>
                            <div class="action">
                                <button>Удалить</button>
                                <button>Добавить</button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" style="font-style:italic;text-align:center;">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>
<style>
    body {
        font-family: 'Times New Roman', Times, serif;
        margin: 0;
        padding: 0;
        background-color: #f8f9fa;
    }

    h1 {
        font-size: 28px;
        font-weight: bold;
        margin-top: 20px;
        text-align: center;
        color: #333;
    }

    .conteiner {
        width: 1000px;
        margin: 20px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        table th {
            background-color: #007bff;
            color: white;
            padding: 12px;
            text-align: left;
        }

        table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

    tbody tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    tbody tr:hover {
        background-color: #e0f7fa;
    }

    .action {
        display: flex;
        justify-content: left;
        gap: 10px;
    }

    .btn_del {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: red;
        color: white;
        transition: background-color 0.2s;
    }

        .btn_del:hover {
            color: white;
            background-color: darkred;
        }

    .btn_edit {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        background-color: green;
        color: white;
        transition: background-color 0.2s;
    }

        .btn_edit:hover {
            color: white;
            background-color: forestgreen;
        }

    .btn_add {
        display: inline-block;
        padding: 8px 12px;
        color: white;
        background-color: blue;
        text-decoration: none;
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

        .btn_add:hover {
            color: white;
            background-color: #007bff;
            transform: scale(1.1);
        }

</style>