@model List<Class>
<h3>Классы</h3>
<div class="conteiner">
    <div class="action">
        <button type="button" id="openModalBtn" class="btn_add">Добавить класс</button>
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    @if (TempData["Error"] != null)
    {
        <div style="color:red;font-size:20px;">@TempData["Error"]</div>
    }
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Название класса</th>
                <th>Количество учеников</th>
                <th>Учебный год</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0 && Model != null)
            {
                @foreach (var cla in Model)
                {
                    <tr>
                        <td>@cla.Id</td>
                        <td>@cla.NumClass@cla.LetterClass</td>
                        <td>@cla.Students.Count()</td>
                        <td>@cla.AcademicYear.Name</td>
                        <td>
                            <div class="action">
                                <form method="post" asp-action="Delete" asp-route-id="@cla.Id" onsubmit="return confirm('Вы уверены что хотите удалить?')">
                                    <button type="submit" class="btn_del">Удалить</button>
                                </form>
                                <button type="button"
                                        class="btn_edit editBtn"
                                        data-id="@cla.Id"
                                        data-num="@cla.NumClass"
                                        data-letter="@cla.LetterClass">
                                    Редактировать
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="2" class="no_info">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>
<div id="addClassModal" class="modal">
    <div class="modal-content">
        <span id="closeModalBtn" class="close">&times;</span>
        <form asp-action="AddClass" method="post">
            <label>Название класса</label>
            <input type="number" name="numClass" min="1" max="11" required />
            <label>Буква класса</label>
            <input type="text" name="letterClass" maxlength="1" required />
            <button type="submit" class="btn_add">Сохранить</button>
        </form>
    </div>
</div>
<div id="editClassModal" class="modal">
    <div class="modal-content">
        <span id="closeEditModal" class="close">&times;</span>

        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" id="editId" />

            <label>Номер класса</label>
            <input type="number" name="numClass" id="editNum" min="1" max="11" required />

            <label>Буква класса</label>
            <input type="text" name="letterClass" id="editLetter" maxlength="1" required />

            <button class="btn_add">Обновить</button>
        </form>
    </div>
</div>
<link rel="stylesheet" href="~/css/index.css" />
<link rel="stylesheet" href="~/css/modalWindow.css" />
<script>
    // Добавление класса
    var addModal = document.getElementById("addClassModal");
    var openAddBtn = document.getElementById("openModalBtn");
    var closeAdd = document.getElementById("closeModalBtn");

    openAddBtn.onclick = function() {
        addModal.classList.add("show");
    }

    closeAdd.onclick = function() {
        addModal.classList.remove("show");
    }

    // Редактирование класса
    var editModal = document.getElementById("editClassModal");
    var closeEdit = document.getElementById("closeEditModal");

    document.querySelectorAll(".editBtn").forEach(btn => {
        btn.onclick = function () {
            document.getElementById("editId").value = this.dataset.id;
            document.getElementById("editNum").value = this.dataset.num;
            document.getElementById("editLetter").value = this.dataset.letter;

            editModal.classList.add("show");
        }
    });

    closeEdit.onclick = function () {
        editModal.classList.remove("show");
    }

    // Закрытие при клике вне окна для обоих модалок
    window.onclick = function(event) {
        if (event.target == addModal) {
            addModal.classList.remove("show");
        }
        if (event.target == editModal) {
            editModal.classList.remove("show");
        }
    }
</script>

