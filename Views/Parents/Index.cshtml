<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f8f9fa;
    }

    h3 {
        font-size: 28px;
        font-weight: bold;
        margin-top: 20px;
        text-align: center;
        color: #333;
    }

    .conteiner {
        width: 1200px;
        margin: 20px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        table th {
            background-color: #007bff;
            color: white;
            padding: 12px;
            text-align: left;
        }

        table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            vertical-align: middle;
        }

    tbody tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    tbody tr:hover {
        background-color: #e0f7fa;
    }

    .action {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn_add,
    .btn_del,
    .btn_edit,
    .btn_back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 140px;
        height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 8px;
        color: white;
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
        box-sizing: border-box;
    }

    .btn_add {
        background-color: #2563eb;
    }

        .btn_add:hover {
            background-color: #1d4ed8;
            transform: translateY(-1px);
        }

    .btn_del {
        background-color: #dc2626;
    }

        .btn_del:hover {
            background-color: #b91c1c;
            transform: translateY(-1px);
        }

    .btn_edit {
        background-color: #16a34a;
    }

        .btn_edit:hover {
            background-color: #15803d;
            transform: translateY(-1px);
        }

    .btn_back {
        background-color: #6b7280;
    }

        .btn_back:hover {
            background-color: #4b5563;
            transform: translateY(-1px);
        }

    .text-danger {
        color: red;
        font-size: 20px;
    }

    a {
        text-decoration: none;
    }

    .child-conteiner {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .child-content {
        display: flex;
        justify-content: space-between;
        width: 100%;
    }
</style>
<link rel="stylesheet" href="~/css/modalWindow.css" />
<script src="~/js/addChild.js"></script>
<style>
    .show {
        display: flex;
        position: fixed;
        z-index: 1000;
        width: 100%;
        background: rgba(0,0,0,.5);
        justify-content: center;
        align-items: center;
    }
</style>

<script>
    const modalForAddChild = document.getElementById("modalAddChild");
    window.onclick = (event)=>{
        if(event.target === modalForAddChild){
            modalForAddChild.classList.remove("show");
        }
    }
</script>