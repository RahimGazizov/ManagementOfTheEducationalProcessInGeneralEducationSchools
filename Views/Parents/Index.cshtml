@model ParentsViewModel
<h3>Родители</h3>
<div class="conteiner">
    <div class="action">
        <a asp-controller="Users" asp-action="AddUsers" class="btn_add">Добавить пользователя</a>
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата рождения</th>
                <th>Номер телефона</th>
                <th>Логин</th>
                <th>Список детей</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Parent != null && Model.Parent.Any())
            {
                @foreach (var par in Model.Parent)
                {
                    <tr>
                        <td>@par.User.FullName</td>
                        <td>@par.User.BirthDate.ToString("dd-MM-yyyy")</td>
                        <td>@par.User.PhoneNumber</td>
                        <td>@par.User.UserName</td>
                        <td>
                            @if (par.Students != null && par.Students.Any())
                            {
                                foreach (var ch in par.Students)
                                {
                                    <div class="child-conteiner">
                                        <div class="child-content">
                                            @($"{ch.User.FullName}({ch.Class.NumClass}{ch.Class.LetterClass})")
                                            <form asp-controller="Parents" asp-action="DeleteChild" method="post" style="display:inline;">
                                                <input type="hidden" name="parentId" value="@par.Id" />
                                                <input type="hidden" name="studentId" value="@ch.Id" />
                                                <button type="submit" onclick="return confirm('Вы уверены что хотите удалить?')"
                                                        style="background-color:red;color:white;border:none;border-radius: 5px;">
                                                    Удалить
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <span>Список детей пуст</span>
                            }
                        </td>

                        <td>
                            <div class="action">
                                <a id="btnAddChild" class="btn_add btnAdChild" data-parent-id="@par.Id" style="cursor: pointer;">Добавить ученика</a>
                                <a asp-controller="Users" asp-action="Delete" asp-route-id="@par.UserId" asp-route-returnUrl="@Url.Action("Index","Parents")"
                                   onsubmit="return confirm('Вы уверены что хотите удалить?')" class="btn_del" style="cursor: pointer;">
                                    Удалить
                                </a>
                                <a asp-controller="Users" asp-action="EditUser" asp-route-id="@par.UserId" asp-route-returnUrl="@Url.Action("Index", "Parents")" class="btn_edit" style="cursor: pointer;">Редактировать</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" style="font-style:italic; text-align:center;">Данных о родителях пусты</td></tr>
            }
        </tbody>
    </table>
</div>


@*Модальное окно добавления ребенка*@
<div class="modal" id="modalAddChild">
    <div class="modal-content">
        <label>Номер класса</label>
        <select id="listNumClass">
            <option>Выберите номер класса</option>
            @for (int i = 1; i < 12; i++)
            {
                <option value="@i">@i</option>
            }
        </select>
        <label>Выберите букву</label>
        <select id="listLetterClass" disabled>
            <option>Сначала выберите номер класса</option>
        </select>
        <label>ФИО ученика</label>
        <select id="listStudentsClass" disabled>
            <option>Сначала выберите номер и букву класса</option>
        </select>
        <button type="submit" id="btnSendData" class="btn_add" style="margin-top:15px;">Добавить</button>
    </div>
</div>

