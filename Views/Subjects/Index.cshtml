@model List<Subjects>

<h3>Предметы</h3>
<div class="conteiner">
    <div class="action">
        <button type="button" id="openModalBtn" class="btn_add">Добавить предмет</button>
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="color:red;">@TempData["ErrorMessage"]</div>
    }

    <table>
        <thead>
            <tr>
                <th>Наименование предмета</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>
                            <div class="action">
                                <form method="post" asp-action="Delete" asp-route-id="@s.Id"
                                      onsubmit="return confirm('Вы уверены что хотите удалить?')">
                                    <button type="submit" class="btn_del">Удалить</button>
                                </form>
                                <button type="button"
                                        data-id="@s.Id"
                                        data-name="@s.Name"
                                        class="btn_edit editBtn">
                                    Редактировать
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td>Список предметов пуст</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Модалка добавления -->
<div id="subjectWindow" class="modal">
    <div class="modal-content">
        <span id="closeAddModalBtn" class="close">&times;</span>
        @if (TempData["Error"] != null)
        {
            <div style="color:red;">@TempData["Error"]</div>
        }
        <form method="post" asp-action="AddSubject">
            <label>Название предмета</label>
            <input type="text" name="subjectName" value="@(TempData["SubjectName"] ?? "")" required />
            <button type="submit" class="btn_add">Добавить</button>
        </form>
    </div>
</div>

<!-- Модалка редактирования -->
<div id="editSubjectWindow" class="modal">
    <div class="modal-content">
        <span id="closeEditModalBtn" class="close">&times;</span>
        @if (TempData["EditError"] != null)
        {
            <div style="color:red;">@TempData["EditError"]</div>
        }
        <form method="post" asp-action="EditSubject">
            <input id="subjectId" type="hidden" name="id" value="@(TempData["IdSub"] ?? "")" />
            <label>Название предмета</label>
            <input id="editSubjectName" type="text" name="subjectName" value="@(TempData["editSub"] ?? "")" required />
            <button type="submit" class="btn_add">Обновить</button>
        </form>
    </div>
</div>

<link rel="stylesheet" href="~/css/index.css" />
<link rel="stylesheet" href="~/css/modalWindow.css" />

<script>
    window.onload = function() {
        const addModal = document.getElementById("subjectWindow");
        const openModalBtn = document.getElementById("openModalBtn");
        const closeAddModalBtn = document.getElementById("closeAddModalBtn");

        const editModal = document.getElementById("editSubjectWindow");
        const closeEditModalBtn = document.getElementById("closeEditModalBtn");

        // Клик по кнопке "Добавить предмет"
        openModalBtn.onclick = function() {
            addModal.classList.add("show");
        };

        // Закрытие крестиком
        closeAddModalBtn.onclick = function() {
            addModal.classList.remove("show");
        };
        closeEditModalBtn.onclick = function() {
            editModal.classList.remove("show");
        };

        // Клик по кнопке редактирования
        document.querySelectorAll(".editBtn").forEach(btn => {
            btn.onclick = function() {
                document.getElementById("subjectId").value = this.dataset.id;
                document.getElementById("editSubjectName").value = this.dataset.name;
                editModal.classList.add("show");
            };
        });

        // Закрытие по клику вне модалки
        window.onclick = function(event) {
            if (event.target === addModal) addModal.classList.remove("show");
            if (event.target === editModal) editModal.classList.remove("show");
        };

        // Показ модалки если есть ошибка
    @if (TempData["Error"] != null)
    {
        <text>addModal.classList.add("show");</text>
    }

    @if (TempData["EditError"] != null)
    {
        <text>editModal.classList.add("show");</text>
    }
    };
</script>
