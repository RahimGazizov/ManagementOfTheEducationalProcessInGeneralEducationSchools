<h1>Сброс пароля</h1>
<div class="conteiner">
    @if (TempData["Error"] != null)
    {
        <div style="color:red;font-size:20px;">@TempData["Error"]</div>
    }
    <form method="post" asp-action="ResetPassword">
        <input type="hidden" name="login" value="@ViewBag.Login" />
        <label>Новый пароль</label>
        <input type="text" name="newPassword" value="@ViewBag.TemproryPas" readonly />
        <button type="submit" class="btn_send">Сбросить пароль</button>
    </form>
</div>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f7fb;
    }

    h1 {
        text-align: center;
        font-size: 26px;
        margin-top: 60px;
        color: #1f2937;
    }

    .conteiner {
        width: 500px;
        padding: 25px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin: 20px auto;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        color: #374151;
        font-weight: 500;
    }

    input{
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        transition: 0.2s;
    }

        input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn_send {
        margin-top: 10px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn_send:hover {
            background: #2563eb;
        }

  
</style>