@model CreateUser
<h1>Добавление пользователя</h1>
<div class="conteiner">
    <form method="post" asp-action="AddUsers">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <label asp-for="FullName">Введите ФИО</label>
        <input type="text" asp-for="FullName" required />
        <label>Телефон</label>
        <div class="inputPhone">
            <select id="countryCode">
                <option value="+996">🇰🇬 +996</option>
            </select>
            <input id="phone" type="tel" placeholder="(___) ___ ___">
            <input type="hidden" name="PhoneNumber" id="phoneHidden">
        </div>
        <label asp-for="Login">Введите логин</label>
        <input type="text" asp-for="Login" required />
        <label asp-for="Password">Пароль</label>
        <input type="text" asp-for="Password" value="@ViewBag.TemproryPassword" readonly required />
        <label asp-for="BirthDate">Введите дату рождения</label>
        <input type="date" asp-for="BirthDate" required />
        <label asp-for="Role">Выберите роль:</label>
        <select id="role" asp-for="Role" asp-items="ViewBag.Roles"></select>
        <div id="classDiv" style="display:none; margin-top:10px;">
            <div class="class">
                <label>Выберите номер класса</label>
                <select id="numClassSelect">
                    <option value="">Выберите номер</option>
                    @for (int i = 1; i < 12; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
                <label>Выберите букву класса</label>
                <select id="letterClassSelect" name="ClassId">
                    <option value="">Сначала выберите номер</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn_add">Добавить</button>
    </form>
</div>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f7fb;
    }

    h1 {
        text-align: center;
        font-size: 26px;
        margin-top: 60px;
        color: #1f2937;
    }

    .conteiner {
        width: 500px;
        padding: 25px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin: 20px auto;
    }
    .inputPhone{
        display: flex;
        justify-content: left;
        gap: 10px;
    }
    form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        color: #374151;
        font-weight: 500;
    }

    input, select {
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        transition: 0.2s;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn_add {
        margin-top: 10px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn_add:hover {
            background: #2563eb;
        }

    .text-danger {
        color: #dc2626;
    }

    .class {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
</style>
<script>
    // --- Показ блока класса только для учеников ---
    const roleSelect = document.getElementById("role");
    const classDiv = document.getElementById("classDiv");

    roleSelect.addEventListener("change", function() {
        if(this.value === "Ученик") {
            classDiv.style.display = "block";
        } else {
            classDiv.style.display = "none";
        }
    });

    // --- AJAX для подгрузки букв по номеру класса ---
    const numClassSelect = document.getElementById("numClassSelect");
    const letterClassSelect = document.getElementById("letterClassSelect");

    numClassSelect.addEventListener("change", function() {
        const numClass = this.value;
        letterClassSelect.innerHTML = '<option value="">Загрузка...</option>';

        if(numClass) {
            fetch(`/Users/GetLetterClass?numClass=${numClass}`)
                .then(res => res.json())
                .then(data => {
                    letterClassSelect.innerHTML = '<option value="">Выберите букву</option>';
                    data.forEach(c => {
                        const opt = document.createElement("option");
                        opt.value = c.id;          // Id класса из базы
                        opt.textContent = c.letterClass; // Буква класса
                        letterClassSelect.appendChild(opt);
                    });
                })
                .catch(() => {
                    letterClassSelect.innerHTML = '<option value="">Ошибка загрузки</option>';
                });
        } else {
            letterClassSelect.innerHTML = '<option value="">Сначала выберите номер</option>';
        }
    });
        const country = document.getElementById("country");
    const phone = document.getElementById("phone");
    const hidden = document.getElementById("phoneHidden");

    phone.addEventListener("input", formatPhone);
    country.addEventListener("change", formatPhone);

    function formatPhone() {

        let digits = phone.value.replace(/\D/g, "");

        let formatted = "";

        if (digits.length > 0)
            formatted = "(" + digits.substring(0,3);

        if (digits.length >= 4)
            formatted += ") " + digits.substring(3,6);

        if (digits.length >= 7)
            formatted += " " + digits.substring(6,9);

        phone.value = formatted;

        hidden.value = country.value.replace("+","") + digits;
    }

</script>
