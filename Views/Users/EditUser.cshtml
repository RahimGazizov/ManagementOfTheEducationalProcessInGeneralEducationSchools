@model EditUserDTO
<h1>Редоктирование пользователя</h1>
<div class="page-header">
    <div style="display: flex; justify-content: left">
        <a href="@TempData["Url"]" class="back-link">← Назад</a>
    </div>
</div>
<div class="conteiner">
    @if (TempData["Error"] != null)
    {
        <div class="text-danger">@TempData["Error"]</div>
    }
    <form method="post" asp-action="EditUser">
        <input type="hidden" name="returnUrl" value="@TempData["Url"]" />
        <input type="hidden" asp-for="UserId" value="@Model.UserId" />
        <label asp-for="FullName">Введите ФИО</label>
        <input type="text" asp-for="FullName" required />
        <label>Телефон</label>
        <input type="tel" asp-for="PhoneNumber" required />
        <label asp-for="Login">Введите логин</label>
        <input type="text" asp-for="Login" required />
        <label asp-for="BirthDate">Введите дату рождения</label>
        <input type="date" asp-for="BirthDate" required />
        <label asp-for="Role">Выберите роль:</label>
        <select id="role" asp-for="Role" asp-items="ViewBag.Roles"></select>
        <div id="classDiv" style="display:none; margin-top:10px;">
            <div class="class">
                <label>Выберите номер класса</label>
                <select id="numClassSelect">
                    <option value="">Выберите номер</option>
                    @for (int i = 1; i < 12; i++)
                    {
                        if (Model.StudentClassNumber == i)
                        {
                            <option value="@i" selected>@i</option>
                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                </select>

                <select id="letterClassSelect" name="StudentClassId">
                    @if (Model.StudentClassLetter != null)
                    {
                        <option value="@Model.StudentClassId" selected>@Model.StudentClassLetter</option>
                    }
                    else
                    {
                        <option value="">Сначала выберите номер</option>
                    }
                </select>
            </div>
        </div>
        <button type="submit" class="btn_add">Обновить</button>
        <a asp-action="ResetPassword"
           asp-controller="Users"
           asp-route-id="@Model.UserId"
           asp-route-returnUrl="@TempData["Url"]"
           class="btn_res">
            Сбросить пароль
        </a>
    </form>
</div>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f7fb;
    }

    h1 {
        text-align: center;
        font-size: 26px;
        margin-top: 60px;
        color: #1f2937;
    }

    .conteiner {
        width: 500px;
        padding: 25px;
        border-radius: 12px;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin: 20px auto;
    }

    .inputPhone {
        display: flex;
        justify-content: left;
        gap: 10px;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    label {
        color: #374151;
        font-weight: 500;
    }

    input, select {
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        outline: none;
        transition: 0.2s;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn_add {
        margin-top: 10px;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn_add:hover {
            background: #2563eb;
        }

    .text-danger {
        color: #dc2626;
    }

    .class {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn_res {
        display: inline-block;
        padding: 8px 16px;
        background-color: #e74c3c; /* ярко-красный */
        color: white;
        font-weight: bold;
        text-decoration: none;
        border-radius: 6px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
        transition: all 0.2s ease-in-out;
    }

        .btn_res:hover {
            background-color: #c0392b; /* чуть темнее при наведении */
            transform: translateY(-2px); /* лёгкое "подпрыгивание" */
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.2);
        }

        .btn_res:active {
            transform: translateY(0); /* при клике кнопка возвращается */
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
        }

    .page-header {
        width: 500px;
        margin: 0 auto;
    }

    .back-link {
        text-decoration: none;
        color: #2a5298;
        font-weight: 500;
        text-align: left;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>
<script>
    const roleSelect = document.getElementById("role");
    const classDiv = document.getElementById("classDiv");

    function toggleClassDiv() {
        if (roleSelect.value === "Ученик") {
            classDiv.style.display = "block";
        } else {
            classDiv.style.display = "none";
        }
    }

    roleSelect.addEventListener("change", toggleClassDiv);
    toggleClassDiv();
</script>
<script src="~/js/classLetter.js"></script>