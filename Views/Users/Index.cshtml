@model List<CreateUser>
<h3>Пользователи</h3>
<div class="conteiner">
    <div class="action">
        <a href="/Users/AddUsers" class="btn_add">Добавить пользователя</a>
        <a href="/AdminPersonalAccount/Index" class="btn_back">Вернуться на главную</a>
    </div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Логин</th>
                <th>Дата рождения</th>
                <th>Роль</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0 && Model != null)
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Login</td>
                        <td>@user.BirthDate.ToString("dd-MM-yyyy")</td>
                        <td>@user.Role</td>
                       @*  <td>
                            <a asp-action="Delete" asp-route-id="@user.UserId" asp-route-returnUrl="@Url.Action("Index", "Users")">Удалить</a>
                        </td> *@
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" style="font-style:italic;text-align:center;">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>
<link rel="stylesheet" href="~/css/index.css">